{
  "name": "@lotmark/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts up",
    "seed": "tsx src/seed/run.ts",
    "reset": "tsx src/reset.ts",
    "migrate:status": "tsx src/migrate.ts status"
  },
  "dependencies": {
    "@lotmark/domain": "workspace:*",
    "@lotmark/security": "workspace:*",
    "@lotmark/stats": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.2"
  }
}
