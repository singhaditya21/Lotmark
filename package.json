{
  "name": "lotmark",
  "version": "0.1.0",
  "private": true,
  "description": "Lotmark \u2014 ISO 17034 reference material producer platform",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @lotmark/db generate",
    "db:migrate": "psql -v ON_ERROR_STOP=1 -q -d lotmark_dev -f packages/db/migrations/0000_initial_schema.sql -f packages/db/migrations/0001_integrity_constraints.sql -f packages/db/migrations/0002_audit_chain.sql",
    "db:seed": "pnpm --filter @lotmark/db seed",
    "db:reset": "pnpm --filter @lotmark/db reset",
    "api": "pnpm --filter @lotmark/api start",
    "smoke": "node apps/api/scripts/smoke.mjs",
    "db:setup": "createdb lotmark_dev 2>/dev/null; pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
