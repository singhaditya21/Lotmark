{
  "name": "lotmark",
  "version": "0.1.0",
  "private": true,
  "description": "Lotmark — ISO 17034 reference material producer platform",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @lotmark/db generate",
    "db:migrate": "pnpm --filter @lotmark/db migrate",
    "db:seed": "pnpm --filter @lotmark/db seed",
    "db:reset": "pnpm --filter @lotmark/db reset",
    "api": "NODE_ENV=development pnpm --filter @lotmark/api start",
    "smoke": "node apps/api/scripts/smoke.mjs",
    "db:setup": "createdb lotmark_dev 2>/dev/null; pnpm db:migrate && pnpm db:seed",
    "web": "pnpm --filter @lotmark/web dev",
    "db:status": "pnpm --filter @lotmark/db migrate:status",
    "worker": "NODE_ENV=development pnpm --filter @lotmark/api worker",
    "job": "NODE_ENV=development pnpm --filter @lotmark/api job",
    "anchor": "NODE_ENV=development pnpm --filter @lotmark/api anchor",
    "demo": "pnpm --filter @lotmark/web demo",
    "demo:capture": "pnpm --filter @lotmark/web capture",
    "demo:narrate": "node tools/video/narrate.mts",
    "demo:record": "node tools/video/record.mts",
    "demo:assemble": "node tools/video/assemble.mts",
    "demo:film": "pnpm demo:narrate && pnpm demo:record && pnpm demo:assemble",
    "demo:films": "for f in main people lowcode assessor; do FILM=$f pnpm demo:narrate && FILM=$f pnpm demo:record && FILM=$f pnpm demo:assemble; done"
  },
  "devDependencies": {
    "kokoro-js": "^1.2.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
