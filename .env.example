# Lotmark configuration.
#
# Nothing reads this file. There is no dotenv anywhere in the repository, on
# purpose: a process that silently picks up a file it happens to be standing
# next to is a process whose configuration you cannot read off its unit file.
# This is a reference — copy the lines you need into the environment of the
# process you are starting.
#
# apps/api/src/config.ts is the authority. Every value below has a comment
# there saying what it is for and what goes wrong without it.
#
# ── Which scripts state NODE_ENV for you, and which do not ──────────────────
#
# The root convenience scripts — `pnpm api`, `pnpm worker`, `pnpm job`,
# `pnpm anchor`, `pnpm dev` — are the local demonstration and set
# NODE_ENV=development themselves. So do `pnpm iq`, `pq` and `rtm`, which are
# validation tooling and only ever run against a development database.
#
# The package-level entry points — `pnpm --filter @lotmark/api start` and
# `worker` — deliberately do NOT. They are what a deployment runs, and a
# deployment has to say what it is. Do not use the root scripts to deploy.


# ── Required, always ────────────────────────────────────────────────────────

# development | test | production. There is NO default: it used to be
# 'development', which meant a deployment that forgot to set it got every
# production refusal in config.ts silently switched off.
NODE_ENV=development


# ── The database ────────────────────────────────────────────────────────────

# The APPLICATION role. Never a superuser and never the schema owner — a
# superuser bypasses row-level security, so tenant isolation would not apply.
DATABASE_URL=postgres://lotmark_app@localhost:5432/lotmark_dev

# The OWNER connection, used only by the scheduler: pg-boss maintains its own
# schema and needs DDL, which the application role deliberately lacks.
DATABASE_ADMIN_URL=postgres://localhost:5432/lotmark_dev

# The SIGNER role: reads the ledger, inserts anchors, nothing else.
DATABASE_SIGNER_URL=postgres://lotmark_signer@localhost:5432/lotmark_dev


# ── Secrets ─────────────────────────────────────────────────────────────────

# The audit chain HMAC key. Lives OUTSIDE the database on purpose: an attacker
# with SQL access must not also hold the key, or the chain proves nothing.
# Production refuses to start on the published default below.
LOTMARK_AUDIT_KEY=dev-audit-key-change-me
LOTMARK_AUDIT_KEY_GENERATION=v1
# Retired generations, for verifying history written before a rotation:
# LOTMARK_AUDIT_KEYS={"v1":"...","v2":"..."}


# ── Signing keys ────────────────────────────────────────────────────────────

# dev_file | env | keychain. kms and hsm are declared and not implemented.
# Production accepts only `env`; the value is printed on every certificate.
SIGNING_KEY_CUSTODY=dev_file
KEYCHAIN_SERVICE=lotmark.signing-key

# Three directories that must not overlap in production, and the process
# refuses to start if they do. The anchor key signs statements ABOUT the ledger
# this process writes, so this process must not be able to read it; documents
# are served to callers and copied wholesale by the DR drill.
SIGNING_KEY_DIR=.keys
ANCHOR_KEY_DIR=.keys-anchor
DOCUMENT_DIR=.documents


# ── Serving ─────────────────────────────────────────────────────────────────

HOST=127.0.0.1
PORT=4000

# Printed on every certificate as the address an auditor is told to visit, so
# in production it must be the public address of the deployment. A localhost
# value is refused: a printed certificate cannot be recalled.
PUBLIC_ORIGIN=http://localhost:5173

# Which proxy, if any, may set the client address. `req.ip` goes into the 21
# CFR 11 audit trail and keys rate limiting, so this decides who can choose
# what the trail says. false, or the proxy's address / CIDR block / a
# comma-separated list / loopback | linklocal | uniquelocal. `true` is refused
# in production. A hop count is refused everywhere — Fastify accepts one and
# then ignores it.
TRUST_PROXY=false


# ── Sessions and signing ────────────────────────────────────────────────────

SESSION_TTL_MINUTES=480
IDLE_TIMEOUT_MINUTES=30
# 21 CFR 11 §11.200(a)(1)(ii): how long a signing session stays "continuous".
SIGNING_WINDOW_MINUTES=15
